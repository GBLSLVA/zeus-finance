# Desenvolvimento local
NODE_ENV=development
APP_ORIGIN=http://localhost:5173
APP_TIMEZONE=America/Sao_Paulo
PORT=3001
DATABASE_PATH=./data/zeus.sqlite
TRUST_PROXY=0
DB_POOL_MAX=5

# Produção no Railway
# Use NODE_ENV=production, TRUST_PROXY=1 e PostgreSQL persistente.
# DATABASE_URL deve apontar para o serviço Postgres do mesmo projeto Railway.
# Nunca versione credenciais reais.
# Exemplo apenas de formato:
# DATABASE_URL=postgresql://postgres.PROJECT_REF:SENHA@HOST.pooler.supabase.com:5432/postgres?sslmode=require

# Recuperação de senha por e-mail
# Em produção, use a URL pública HTTPS do ZEUS sem barra final.
# Na Hostnet, atualize esta variável depois de confirmar domínio + SSL.
APP_BASE_URL=http://localhost:5173
# RESEND_API_KEY=re_xxxxxxxxx
# PASSWORD_RESET_EMAIL_FROM=ZEUS Finance <acesso@seudominio.com>
