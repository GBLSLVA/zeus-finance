# Desenvolvimento local
NODE_ENV=development
APP_ORIGIN=http://localhost:5173
APP_TIMEZONE=America/Sao_Paulo
PORT=3001
DATABASE_PATH=./data/zeus.sqlite
TRUST_PROXY=0
DB_POOL_MAX=5

# Nuvem / Render + Supabase
# No Render, use NODE_ENV=production e TRUST_PROXY=1.
# Copie para DATABASE_URL a connection string "Session pooler" do Supabase.
# Exemplo apenas de formato:
# DATABASE_URL=postgresql://postgres.PROJECT_REF:SENHA@HOST.pooler.supabase.com:5432/postgres?sslmode=require

# Recuperação de senha por e-mail
# Em produção, use a URL pública HTTPS do ZEUS sem barra final.
APP_BASE_URL=http://localhost:5173
# RESEND_API_KEY=re_xxxxxxxxx
# PASSWORD_RESET_EMAIL_FROM=ZEUS Finance <acesso@seudominio.com>
