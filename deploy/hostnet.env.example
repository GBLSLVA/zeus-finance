# Hostnet App Cloud / container
NODE_ENV=production
PORT=10000
TRUST_PROXY=1
APP_TIMEZONE=America/Sao_Paulo
APP_ORIGIN=same-origin
APP_BASE_URL=https://SEU-DOMINIO-AQUI
DB_POOL_MAX=5

# Banco persistente: mantenha o Supabase na primeira fase da migração.
# Use a Session Pooler connection string do Supabase.
DATABASE_URL=postgresql://USUARIO:SENHA@HOST:5432/postgres?sslmode=require

# Recuperação de senha
RESEND_API_KEY=re_xxxxxxxxx
PASSWORD_RESET_EMAIL_FROM=ZEUS Finance <acesso@seudominio.com>

# NÃO habilite ALLOW_SQLITE_PRODUCTION na Hostnet.
# Em produção o ZEUS deve usar PostgreSQL persistente.
